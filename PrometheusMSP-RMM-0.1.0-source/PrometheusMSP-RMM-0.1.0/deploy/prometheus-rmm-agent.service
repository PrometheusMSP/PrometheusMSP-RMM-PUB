[Unit]
Description=Prometheus MSP RMM Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/prometheus-rmm/agent.env
ExecStart=/usr/local/sbin/prometheus-rmm-agent
Restart=on-failure
RestartSec=15s
User=root
Group=root
NoNewPrivileges=true
ProtectHome=true
LockPersonality=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
